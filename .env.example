# Local Express server (server.js)
PORT=3000
WEATHER_API_KEY=replace_with_your_weatherapi_key

# Cloudflare Worker runtime (_worker.js)
# Set these as platform secrets/variables, never in browser code or Git.
SUPABASE_SERVICE_ROLE=replace_with_server_only_service_role_key
APP_ACCESS_COOKIE_SECRET=replace_with_a_long_random_secret
WEATHER_API_KEY=replace_with_your_weatherapi_key

# Optional Worker configuration. These values are not secrets, but must match
# the client project configuration if set.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_key
